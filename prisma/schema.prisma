generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  name           String               @db.VarChar(255)
  email          String               @unique @db.VarChar(255)
  password       String
  phone_number   BigInt
  role           user_role
  is_active      Boolean
  created_at     DateTime             @default(now()) @db.Date
  updated_at     DateTime             @updatedAt @db.Date
  activity_logs  ActivityLog[]
  company        Company?
  comments_sent  ApplicationComment[] @relation("CommentSender")
  otp_codes      OtpCode[]
  refresh_tokens RefreshToken[]

  @@map("Users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Company {
  id                  String        @id @default(uuid()) @db.Uuid
  user_id             String        @unique @db.Uuid
  company_name        String
  phone_number        BigInt
  country             String
  sector              String
  registration_number BigInt
  contact_person      String
  applications        Application[]
  certificates        Certificate[]
  user                User          @relation(fields: [user_id], references: [id])
  dashboard           Dashboard?

  @@index([id])
  @@map("Companies")
}

model Dashboard {
  id                    String  @id @db.Uuid
  TotalApplication      Int
  RejectedApplication   Int
  ActiveCetificates     Int
  SuspendCertificates   Int
  WithdrawnCertificates Int
  ExpiredCertificates   Int
  company               Company @relation(fields: [id], references: [id])

  @@map("Dashboard")
}

model Application {
  id               String                 @id @default(uuid()) @db.Uuid
  application_no   String                 @unique @db.VarChar(255)
  receiver_id      BigInt                 @unique
  company_name     String                 @db.VarChar(255)
  company_id       String                 @db.Uuid
  status           String                 @db.VarChar(255)
  certificate_type String                 @db.VarChar(255)
  paid             Boolean                @default(false)
  submitted_at     BigInt
  timelines        ActivityTimeline[]
  logs             ActivityLog[]
  answers          Answer[]
  company          Company                @relation(fields: [company_id], references: [id])
  conditions       ApplicationCondition[]
  documents        ApplicationDocument[]
  certificates     Certificate[]
  details          CompanyDetail[]
  comments         ApplicationComment[]

  @@index([id])
  @@map("Application")
}

model ApplicationDocument {
  id             String      @id @default(uuid()) @db.Uuid
  application_id String      @db.Uuid
  document_type  String
  file_name      String      @db.VarChar(255)
  file_url       String
  uploaded_at    DateTime    @db.Date
  application    Application @relation(fields: [application_id], references: [id])

  @@map("Application_Documents")
}

model ApplicationCondition {
  id             String      @id @default(uuid()) @db.Uuid
  application_id String      @db.Uuid
  reason         String
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("Application_Conditions")
}

model Certificate {
  id               String      @id @default(uuid()) @db.Uuid
  company_id       String      @db.Uuid
  application_id   String      @db.Uuid
  certificate_type String
  status           String
  issued           DateTime    @db.Date
  expiry           DateTime    @db.Date
  sites            Int
  paid             Boolean
  application      Application @relation(fields: [application_id], references: [id])
  company          Company     @relation(fields: [company_id], references: [id])

  @@index([id])
  @@map("Certificates")
}

model Survey {
  id        BigInt     @id @default(autoincrement())
  title     String
  questions Question[]
  sections  Section[]

  @@index([id])
  @@map("Survey")
}

model Section {
  id           BigInt     @id @default(autoincrement())
  survey_id    BigInt
  section_name String
  questions    Question[]
  survey       Survey     @relation(fields: [survey_id], references: [id])

  @@map("Section")
}

model Question {
  id            BigInt   @id @default(autoincrement())
  survey_id     BigInt
  section_id    BigInt
  question_text String
  question_type String   @db.VarChar(50)
  is_required   Boolean
  answers       Answer[]
  section       Section  @relation(fields: [section_id], references: [id])
  survey        Survey   @relation(fields: [survey_id], references: [id])

  @@index([id])
  @@map("Questions")
}

model Answer {
  id             BigInt      @id @default(autoincrement())
  application_id String      @db.Uuid
  question_id    BigInt
  survey_answers String
  partial_text   String?
  application    Application @relation(fields: [application_id], references: [id])
  question       Question    @relation(fields: [question_id], references: [id])

  @@map("Answer")
}

model CompanyDetail {
  registration_no     BigInt           @id
  application_id      String           @db.Uuid
  company_name        String
  tax_registration_no BigInt
  buisness_type       String           @db.VarChar(255)
  sector              String           @db.VarChar(255)
  contact_no          BigInt
  scope               String           @db.VarChar(255)
  multiple_sites      Boolean
  site_details        Json
  employees           Json
  certifications      Json
  additional_notes    String
  updated_at          DateTime         @db.Date
  brands              Brand[]
  addresses           CompanyAddress[]
  application         Application      @relation(fields: [application_id], references: [id])
  esg_details         ESGDetails[]

  @@map("Company_detail")
}

model Brand {
  id                   BigInt        @id @default(autoincrement())
  company_id           BigInt
  activities           String        @db.VarChar(255)
  products             String        @db.VarChar(255)
  critical_process     Boolean
  outsourced_processed Boolean
  company_detail       CompanyDetail @relation(fields: [company_id], references: [registration_no])
  sub_brands           SubBrand[]

  @@map("Brand")
}

model SubBrand {
  id         BigInt @id @default(autoincrement())
  brand_id   BigInt
  brand_name String @db.VarChar(255)
  brand_skus Int
  brand      Brand  @relation(fields: [brand_id], references: [id])

  @@map("Sub_Brand")
}

model CompanyAddress {
  id                 BigInt        @id @default(autoincrement())
  company_id         BigInt
  headoffice_address String
  national_address   String?
  detailed_address   String
  company_detail     CompanyDetail @relation(fields: [company_id], references: [registration_no])

  @@map("Comapny_Address")
}

model ESGDetails {
  id                        BigInt        @id @default(autoincrement())
  company_id                BigInt
  program_in_place          Boolean
  has_esh_policy            Boolean
  has_sustainability_report Boolean
  has_ghg_monitoring        Boolean
  has_energy_management     Boolean
  has_social_responsibility Boolean
  has_grc_framework         Boolean
  company_detail            CompanyDetail @relation(fields: [company_id], references: [registration_no])

  @@map("ESG_Details")
}

model CertificateManagement {
  id               String  @id @default(uuid()) @db.Uuid
  certificate_name String? @db.VarChar(255)
  certificate_type String? @db.VarChar(255)
  duration         Int
  application_fee  BigInt
  certificate_fee  BigInt
  status           Boolean

  @@map("Certificate_Management")
}

model ActivityLog {
  id             String      @id @default(uuid()) @db.Uuid
  user_id        String      @db.Uuid
  application_id String      @db.Uuid
  user_name      String
  action_text    String
  created_at     DateTime    @db.Timestamp(6)
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [user_id], references: [id])

  @@map("All_Activity_Log")
}

model ActivityTimeline {
  id             String      @id @default(uuid()) @db.Uuid
  application_id String      @db.Uuid
  email          String      @db.VarChar(255)
  action_text    String
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("Activity_Timeline")
}

model ApplicationComment {
  id             BigInt      @id @default(autoincrement())
  application_id String      @db.Uuid
  sender_id      String      @db.Uuid
  comment_text   String
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  sender         User        @relation("CommentSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@map("application_comments")
}

model OtpCode {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  otp_code   String   @db.VarChar(6)
  expires_at DateTime @db.Timestamptz(6)
  verified   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([otp_code])
  @@map("otp_codes")
}

enum user_role {
  ADMIN
  COMPANY
  CONSULTANT
}

